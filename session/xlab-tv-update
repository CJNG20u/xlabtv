#!/bin/sh
# xLab TV's "Updates" tile: updates xLab TV, Flatpak apps and Ubuntu in one go.
# install.sh fills in where the xlabtv checkout lives.
REPO="@REPO@"

step() { printf '\n\033[1;36m== %s\033[0m\n' "$*"; }
failed=0

step "xLab TV"
if [ -d "$REPO/.git" ]; then
    # a git checkout: pull and reinstall (builds the UI)
    if (cd "$REPO" && git pull --ff-only && sh install.sh); then
        echo "xLab TV is up to date (changes show after the next restart of xLab TV)."
    else
        echo "Could not update xLab TV."; failed=1
    fi
elif [ -f "$REPO/get.sh" ]; then
    # installed from the ready-made package: fetch the latest one
    if [ "$(cat /usr/lib/xlab-tv/version 2>/dev/null)" = "$(wget -qO- https://github.com/CJNG20u/xlabtv/releases/download/latest/VERSION 2>/dev/null)" ]; then
        echo "xLab TV is already up to date."
    elif sh "$REPO/get.sh"; then
        echo "xLab TV is up to date (changes show after the next restart of xLab TV)."
    else
        echo "Could not update xLab TV."; failed=1
    fi
else
    echo "Don't know where xLab TV was installed from ($REPO); skipped."
fi

step "Apps (Flatpak)"
flatpak update --user -y --noninteractive || failed=1

step "Ubuntu (asks for your password; type it with the phone remote)"
if sudo apt-get update && sudo apt-get -y upgrade; then :; else failed=1; fi

if [ "$failed" -eq 0 ]; then
    step "All done"
else
    step "Finished with problems (see above)"
fi
printf 'Press Enter (OK on the remote) to close.'
read -r _
